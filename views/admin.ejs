<link rel="stylesheet" href="/css/admin-dashboard.css">

<div class="container py-4 admin-dashboard">
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
    <h1 class="mb-0">Painel Administrativo</h1>
    <span class="badge bg-primary-subtle text-primary-emphasis px-3 py-2">
      Gestão de denúncias - Patas Seguras
    </span>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-md-6 col-xl-3">
      <div class="card stat-card border-0 shadow-sm">
        <div class="card-body">
          <h6 class="text-muted">Denúncias Recebidas</h6>
          <p class="display-6 fw-bold mb-0" id="totalCount">0</p>
        </div>
      </div>
    </div>

    <div class="col-md-6 col-xl-3">
      <div class="card stat-card border-0 shadow-sm">
        <div class="card-body">
          <h6 class="text-muted">Casos Pendentes</h6>
          <p class="display-6 fw-bold mb-0 text-warning" id="pendingCount">0</p>
        </div>
      </div>
    </div>

    <div class="col-md-6 col-xl-3">
      <div class="card stat-card border-0 shadow-sm">
        <div class="card-body">
          <h6 class="text-muted">Casos Resolvidos</h6>
          <p class="display-6 fw-bold mb-0 text-success" id="resolvedCount">0</p>
        </div>
      </div>
    </div>

    <div class="col-md-6 col-xl-3">
      <div class="card stat-card border-0 shadow-sm">
        <div class="card-body">
          <h6 class="text-muted">Casos Urgentes</h6>
          <p class="display-6 fw-bold mb-0 text-danger" id="urgentCount">0</p>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-xl-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <h5 class="card-title mb-3">Denúncias nos Últimos Meses</h5>
          <canvas id="monthlyChart"></canvas>
        </div>
      </div>
    </div>

    <div class="col-xl-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <h5 class="card-title mb-3">Denúncias por Região</h5>
          <canvas id="cityChart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-body">
      <h5 class="mb-3">Denúncias Recentes</h5>

      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead>
            <tr>
              <th>ID</th>
              <th>Animal</th>
              <th>Cidade</th>
              <th>Status</th>
              <th>Data</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody id="complaintsTable"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/js/admin-dashboard.js"></script>