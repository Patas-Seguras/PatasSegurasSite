<link rel="stylesheet" href="/css/admin-dashboard.css">

<div class="container py-4 admin-dashboard">

<div class="d-flex justify-content-between align-items-center mb-4">
<div>
<h1 class="mb-1">Denúncia <span id="complaintId"></span></h1>
<span class="badge" id="complaintStatus"></span>
</div>
<a href="/admin" class="btn btn-outline-primary">Voltar ao painel</a>
</div>

<div class="row g-3">

<div class="col-lg-8">

<div class="card shadow-sm mb-3">
<div class="card-body">
<h5>Detalhes da denúncia</h5>

<p><strong>Animal:</strong> <span id="animal"></span></p>
<p><strong>Descrição:</strong> <span id="description"></span></p>
<p><strong>Cidade:</strong> <span id="city"></span></p>
<p><strong>Endereço:</strong> <span id="address"></span></p>
<p><strong>Data:</strong> <span id="createdAt"></span></p>

</div>
</div>

<div class="card shadow-sm mb-3">
<div class="card-body">
<h5>Informações do denunciante</h5>

<p><strong>Nome:</strong> <span id="name"></span></p>
<p><strong>Email:</strong> <span id="email"></span></p>
<p><strong>Telefone:</strong> <span id="number"></span></p>

</div>
</div>

<div class="card shadow-sm mb-3">
<div class="card-body">

<h5>Histórico de ações</h5>

<div id="actionsList"></div>

</div>
</div>

<div class="card shadow-sm">
<div class="card-body">

<h5>Mensagens</h5>

<form id="messageForm">

<textarea id="messageText" class="form-control mb-2" rows="3"></textarea>

<button class="btn btn-primary">Enviar</button>

</form>

<div id="messagesList" class="mt-3"></div>

</div>
</div>

</div>

<div class="col-lg-4">

<div class="card shadow-sm">

<div class="card-body">

<h5>Ações do administrador</h5>

<form id="statusForm">

<select id="statusSelect" class="form-select mb-3"></select>

<textarea id="reportText" class="form-control mb-3"></textarea>

<button class="btn btn-success w-100">Salvar atualização</button>

</form>

</div>

</div>

</div>

</div>

</div>

<script src="/js/admin-detail.js"></script>