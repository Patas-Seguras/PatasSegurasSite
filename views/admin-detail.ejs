<link rel="stylesheet" href="/css/admin-dashboard.css">

<div class="container py-4 admin-dashboard">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
      <h1 class="mb-1">Denúncia #<%= complaint.id %></h1>
      <span class="badge bg-<%= complaint.badgeClass %>"><%= complaint.statusLabel %></span>
    </div>
    <a href="/admin" class="btn btn-outline-primary">Voltar ao painel</a>
  </div>

  <div class="row g-3">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
          <h5>Detalhes da denúncia</h5>
          <p><strong>Animal:</strong> <%= complaint.animal %></p>
          <p><strong>Descrição:</strong> <%= complaint.description %></p>
          <p><strong>Cidade:</strong> <%= complaint.city || 'Não informada' %></p>
          <p><strong>Endereço:</strong> <%= complaint.address || 'Não informado' %></p>
          <p><strong>Data da denúncia:</strong> <%= new Date(complaint.createdAt).toLocaleString('pt-BR') %></p>
        </div>
      </div>

      <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
          <h5>Informações do denunciante</h5>
          <p><strong>Nome:</strong> <%= complaint.name || 'Não informado' %></p>
          <p><strong>Email:</strong> <%= complaint.email || 'Não informado' %></p>
          <p><strong>Telefone:</strong> <%= complaint.number || 'Não informado' %></p>
        </div>
      </div>

      <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
          <h5>Histórico de ações</h5>
          <% if (!complaint.actions || complaint.actions.length === 0) { %>
            <p class="text-muted mb-0">Nenhuma ação registrada até agora.</p>
          <% } %>
          <% (complaint.actions || []).forEach((action) => { %>
            <div class="border rounded p-2 mb-2">
              <span class="badge bg-secondary"><%= statusLabels[action.status] || action.status %></span>
              <p class="mb-1 mt-2"><%= action.relatorio %></p>
              <small class="text-muted"><%= new Date(action.createdAt).toLocaleString('pt-BR') %> • <%= action.adminEmail || 'admin' %></small>
            </div>
          <% }) %>
        </div>
      </div>

      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <h5>Mensagens para o denunciante</h5>
          <form method="POST" action="/admin/denuncias/<%= complaint.id %>/mensagens" class="mb-3">
            <textarea name="texto" class="form-control mb-2" rows="3" placeholder="Digite a mensagem"></textarea>
            <button class="btn btn-primary" type="submit">Enviar mensagem</button>
          </form>
          <% if (!complaint.messages || complaint.messages.length === 0) { %>
            <p class="text-muted mb-0">Nenhuma mensagem enviada.</p>
          <% } %>
          <% (complaint.messages || []).forEach((message) => { %>
            <div class="border rounded p-2 mb-2">
              <p class="mb-1"><%= message.texto %></p>
              <small class="text-muted"><%= message.remetente %> • <%= new Date(message.createdAt).toLocaleString('pt-BR') %></small>
            </div>
          <% }) %>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <h5>Ações do administrador</h5>
          <form method="POST" action="/admin/denuncias/<%= complaint.id %>/status">
            <div class="mb-3">
              <label class="form-label">Alterar status</label>
              <select name="status" class="form-select" required>
                <% Object.entries(statusLabels).forEach(([value, label]) => { %>
                  <option value="<%= value %>" <%= complaint.normalizedStatus === value ? 'selected' : '' %>><%= label %></option>
                <% }) %>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Relatório da ação</label>
              <textarea class="form-control" rows="4" name="relatorio" placeholder="Contato realizado com ONG local e polícia ambiental."></textarea>
            </div>
            <button class="btn btn-success w-100" type="submit">Salvar atualização</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
