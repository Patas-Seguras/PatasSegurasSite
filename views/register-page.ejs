<link rel="stylesheet" href="css/register-page.css">
<link rel="stylesheet" href="css/popup.css">

<div class="container-fluid register-container min-vh-100 d-flex align-items-center justify-content-center">

    <div class="shadow register-container2 p-3 p-sm-4 rounded-4 w-100" style="max-width: 500px;">
        <div class="row mb-4">
            <div class="col-12 text-center">
                <h2 class="mb-3 fs-4 fs-md-3">Registre-se</h2>
            </div>
        </div>
        <form method="POST" action="/register-page" id="registerForm" enctype="application/x-www-form-urlencoded">

            <div class="row mb-3">
                <div class="col-12">
                    <input type="email" class="form-control" id="email" name="email" placeholder="Digite seu Email">
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-12">
                    <input type="password" class="form-control" id="password" name="password" placeholder="Digite sua senha">
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-12">
                    <input type="password" class="form-control" id="passwordAgain" name="passwordAgain" placeholder="Confirme sua senha">
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <button type="submit" class="btn btn-primary btn-lg w-100" style="min-height: 50px;" onclick="confirmar()">Registrar</button>
                </div>
            </div>
        </form>
    </div>
</div>

<script src="/js/register-page.js"></script>